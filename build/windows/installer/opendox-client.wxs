<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI-Installer für openDox, gebaut mit `wixl` (Paket msitools, natives Linux —
  kein Wine nötig) statt des von Wails mitgelieferten NSIS-Installers
  (project.nsi in diesem Verzeichnis, bleibt unverändert bestehen). Gedacht für
  GPO-/SCCM-/Intune-artige Enterprise-Verteilung, wo .msi das native Format ist.

  Aufruf über ./build-windows-msi.sh (Repo-Root), das die Preprocessor-Variablen
  ProductName, Manufacturer, Version, ExePath, SettingsTemplatePath und IconPath
  per `wixl -D ...` befüllt.

  Installationskontext: maschinenweit (Program Files, $PROGRAMFILES64\openDox),
  wie project.nsi's Standard-Scope — passend zum eigentlichen Einsatzzweck dieses MSI
  (GPO-/SCCM-/Intune-Rollout durch IT, die ohnehin mit Admin-Rechten deployt) und deckt
  mit einer Installation alle Windows-Konten auf einem gemeinsam genutzten
  Praxis-/Klinik-PC ab. Braucht Admin/Elevation beim Setup.

  Server-URL: die settings.json (Component SettingsJson unten, aus
  SettingsTemplatePath) landet direkt neben der .exe in Program Files. loadSettings()
  in app.go liest genau diese Datei (exeDirSettingsPath()) VOR dem plattformüblichen
  %AppData%-Fallback. IT/Admin passt die Server-URL nach der Installation einfach per
  Texteditor (mit Adminrechten, da Program Files) in dieser Datei an — kein
  msiexec-Property, kein Rebuild pro Kunde. Eine frühere Version versuchte stattdessen,
  die URL über eine deferred CustomAction beim Setup selbst in die Datei zu schreiben
  (erneuter Aufruf von opendox-client.exe in einem eigenen Kommandozeilen-Hilfsmodus) —
  das scheiterte auf einer echten Windows-Installation wiederholt und ohne eindeutig
  identifizierbare Ursache (Kandidaten: FileKey-Pfadauflösung, CustomActionData-
  Weiterreichung, oder ein weiterer wixl-Bug — keiner davon ließ sich ohne
  Windows-Testumgebung zweifelsfrei verifizieren). Ein danach versuchter Zwischenschritt
  über eine HKLM-Registry-Property (SERVERURL) funktionierte zwar deklarativ beim
  Schreiben, wurde aber von loadSettings() nie gelesen — schlicht totes Gewicht. Die
  einfache Datei-Deployment-Komponente unten ist der zuverlässigste Weg: kein
  CustomAction-Mechanismus involviert, nur der normale MSI-File-Table-Kopiervorgang.

  UpgradeCode (unten in <Upgrade Id="...">) darf sich über KEINE künftige Version
  mehr ändern — er ist die einzige Kennung, über die der Windows Installer ein
  Release als Upgrade eines bereits installierten Produkts statt als komplett
  neues Produkt erkennt.

  Phase 1 (dieser Stand): reine Datei-/Verknüpfungs-/Upgrade-Installation, noch
  ohne WebView2-Runtime-Bootstrap. Phase 2 (separat nachgezogen und getestet,
  siehe Plan): CustomAction + Binary, die bei Bedarf still die bereits unter
  installer/tmp/MicrosoftEdgeWebview2Setup.exe vorhandene Evergreen-Bootstrapper-
  exe nachzieht, analog zu project.nsi's wails.webview2runtime-Makro, gegated über
  dieselbe Registry-Prüfung
  (HKLM\SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}
  Wert "pv").
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="$(var.ProductName)"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="$(var.Manufacturer)"
           UpgradeCode="8A5B7D61-7439-409A-8A5B-1398C0EF340D">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />

    <Media Id="1" Cabinet="opendox.cab" EmbedCab="yes" />

    <!-- Major-Upgrade-Handling: entfernt jede bereits installierte ältere Version
         beim Installieren einer neuen. Bewusst über die klassischen
         Upgrade/UpgradeVersion-Elemente statt des MajorUpgrade-Kurzelements, da
         diese sicher im von wixl unterstützten WiX-Subset liegen. -->
    <Upgrade Id="8A5B7D61-7439-409A-8A5B-1398C0EF340D">
      <UpgradeVersion Minimum="0.0.0" Maximum="$(var.Version)"
                       IncludeMinimum="yes" IncludeMaximum="no"
                       Property="OLDERVERSIONFOUND" OnlyDetect="no" />
    </Upgrade>

    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallExecute" />
    </InstallExecuteSequence>

    <Icon Id="icon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="icon.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="$(var.ProductName)">
          <Component Id="MainExecutable" Guid="FF68B69F-323C-41D2-A1C2-3072A59239A4">
            <File Id="opendoxEXE" Name="opendox-client.exe" Source="$(var.ExePath)" KeyPath="yes" />
          </Component>
          <!-- Wichtig: diese wixl-Version (msitools 0.103) implementiert die
               WiX-Attribute NeverOverwrite/Permanent auf Component NICHT (nur Guid/
               KeyPath/Win64/DiskId werden geparst — verifiziert über die im wixl-
               Binary vorhandenen GObject-Property-Strings). Der einzige Schutz für
               eine von IT angepasste Server-URL ist daher die über Versionen hinweg
               STABILE Component-Guid unten: bei einem In-Place-Major-Upgrade
               installiert die neue Produktversion die Datei zuerst (siehe
               RemoveExistingProducts After="InstallExecute" oben), danach sinkt beim
               Entfernen der alten Version deren Referenzzähler auf dieselbe Guid nur
               auf 1 (nicht 0), sodass die Datei NICHT gelöscht wird — Windows
               Installer überschreibt eine bereits vorhandene, nicht neu versionierte
               Datei bei diesem Ablauf i.d.R. ebenfalls nicht. Eine ECHTE
               Deinstallation (kein Upgrade) entfernt settings.json aber trotzdem
               mit, da ohne Permanent kein Referenzzähler-Schutz greift — anders als
               ursprünglich geplant, aber mit dieser wixl-Version nicht erreichbar. -->
          <Component Id="SettingsJson" Guid="C2840E38-3FA1-42DD-AC6E-A63CCEF0ABCC">
            <File Id="settingsJson" Name="settings.json" Source="$(var.SettingsTemplatePath)" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="$(var.ProductName)" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="B2A0B40C-B045-4721-9B3F-EFDBB48538EC">
        <Shortcut Id="StartMenuShortcutLnk" Name="$(var.ProductName)" Target="[#opendoxEXE]"
                   WorkingDirectory="INSTALLFOLDER" Icon="icon.ico" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\$(var.Manufacturer)\$(var.ProductName)"
                        Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="0F9BAD76-2D59-486E-BB5A-09174D7DFB13">
        <Shortcut Id="DesktopShortcutLnk" Name="$(var.ProductName)" Target="[#opendoxEXE]"
                   WorkingDirectory="INSTALLFOLDER" Icon="icon.ico" />
        <RegistryValue Root="HKCU" Key="Software\$(var.Manufacturer)\$(var.ProductName)"
                        Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="MainFeature" Title="$(var.ProductName)" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="SettingsJson" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

  </Product>
</Wix>
